# Spore environment variables
# Copy to .env and adjust values: cp .env.example .env

# Flask
SECRET_KEY=change-me-in-production
DEBUG=True
APP_HOST=127.0.0.1
APP_PORT=5000

# Session store (KeyDB/Redis)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS / Socket.IO (comma-separated origins)
ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000

# Fernet key for encrypting connection credentials in session (required)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# Data paths (shared by Flask ingest and sandboxed kernel containers)
SPORE_DATA_DIR=/data
KERNEL_DATA_MOUNT=/data

# Containerized Jupyter kernel (Docker / DinD)
KERNEL_PYTHON_VERSION=3.12
# Local source compose builds this tag into DinD; Docker Hub compose uses
# anshsharma2903/spore-kernel:3.12 instead (see docker/docker-compose.hub.yml).
KERNEL_IMAGE=spore-kernel:3.12
KERNEL_HOST=kernel-dind
KERNEL_VOLUME_BIND=/data
KERNEL_NETWORK=kernel_net
KERNEL_VOLUME=spore_volumes
DOCKER_HOST=tcp://kernel-dind:2375
KERNEL_MEM_LIMIT=1g
KERNEL_PIDS_LIMIT=256

# LLM provider base URLs. These are the DEFAULTS — each can also be overridden
# per-provider at runtime from the in-app Settings page (saved to settings.json).
# In Docker, a host-run Ollama/LM Studio must listen on 0.0.0.0 to be reachable
# from the container (host.docker.internal -> host gateway).
OLLAMA_BASE=http://localhost:11434
OLLAMA_ENDPOINT=http://localhost:11434/api/generate
LMSTUDIO_BASE=http://localhost:1234
LMSTUDIO_ENDPOINT=http://localhost:1234
OPENAI_BASE=https://api.openai.com/v1

# Cloud LLM API keys (optional)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Optional SQLAlchemy URI (reserved for future persistent app DB)
SQLALCHEMY_URI=
