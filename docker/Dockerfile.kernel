ARG KERNEL_BASE_IMAGE=python:3.12-slim
FROM ${KERNEL_BASE_IMAGE}

WORKDIR /data

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir \
    ipykernel \
    pandas \
    numpy \
    polars \
    plotly \
    duckdb \
    pyarrow \
    openpyxl

ARG EXTRA_PACKAGES=
RUN if [ -n "$EXTRA_PACKAGES" ]; then pip install --no-cache-dir $EXTRA_PACKAGES; fi

COPY docker/kernel-entrypoint.sh /usr/local/bin/kernel-entrypoint.sh
RUN chmod +x /usr/local/bin/kernel-entrypoint.sh

RUN useradd -m -u 1000 kernel && chown -R kernel:kernel /data
USER kernel

ENTRYPOINT ["/usr/local/bin/kernel-entrypoint.sh"]
