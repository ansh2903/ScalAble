# syntax=docker/dockerfile:1
ARG KERNEL_BASE_IMAGE=python:3.12-slim
FROM ${KERNEL_BASE_IMAGE}

WORKDIR /data

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Base notebook stack — cached independently of user-managed packages.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install \
    ipykernel \
    nbformat \
    nbconvert \
    nbclient \
    pandas \
    numpy \
    polars \
    plotly \
    duckdb \
    pyarrow \
    openpyxl

# User-managed packages from Settings; only this layer rebuilds when they change.
ARG EXTRA_PACKAGES=
RUN --mount=type=cache,target=/root/.cache/pip \
    if [ -n "$EXTRA_PACKAGES" ]; then pip install $EXTRA_PACKAGES; fi

COPY docker/kernel-entrypoint.sh /usr/local/bin/kernel-entrypoint.sh
RUN chmod +x /usr/local/bin/kernel-entrypoint.sh

RUN useradd -m -u 1000 kernel && chown -R kernel:kernel /data
USER kernel

ENTRYPOINT ["/usr/local/bin/kernel-entrypoint.sh"]
