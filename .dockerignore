# Python caches & build artifacts (patterns must use **/ to match at any depth)
**/__pycache__/
**/*.py[cod]
**/*.egg-info/
**/.eggs/
**/build/
**/dist/

# Virtual envs
**/.venv/
**/venv/
**/env/

# VCS / editor / OS
**/.git/
**/.gitignore
**/.idea/
**/.vscode/
**/.DS_Store

# Local config & secrets (never bake into images)
**/.env
**/*.env
!.env.example

# Test / notebook scratch & local data
test/
tests/
data/
**/.ipynb_checkpoints/

# Docs (not needed at runtime)
docs/
*.md
!README.md
